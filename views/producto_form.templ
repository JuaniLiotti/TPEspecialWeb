package views

// ProductoForm es el formulario de alta de productos. Hace un POST clásico a
// /productos (multipart/form-data porque puede llevar imágenes).
templ ProductoForm(f ProductoFormData) {
	<form class="formulario" method="post" action="/productos" enctype="multipart/form-data">
		<h3>Nuevo producto</h3>
		<label>
			Nombre
			<input type="text" name="nombre" value={ f.Nombre } required/>
		</label>
		<label>
			Categoría
			<input type="text" name="categoria" value={ f.Categoria } placeholder="Alfombras, bajo monturas..."/>
		</label>
		<label>
			Color
			<input type="text" name="color" value={ f.Color }/>
		</label>
		<label>
			Precio ($)
			<input type="number" name="precio" value={ f.Precio } step="1" min="1" required/>
		</label>
		<label>
			Descripción
			<textarea name="descripcion" rows="3">{ f.Descripcion }</textarea>
		</label>
		<label>
			Imágenes
			<input type="file" name="imagenes" accept="image/jpeg,image/png,image/webp" multiple/>
		</label>
		if f.Error != "" {
			<p class="mensaje-error" role="alert">{ f.Error }</p>
		}
		<button type="submit">Agregar producto</button>
	</form>
}
