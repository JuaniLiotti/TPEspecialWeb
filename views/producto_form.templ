package views

// productoForm es el formulario de alta de productos. Funciona igual que cueroForm

templ productoForm(f ProductoFormData, oob bool) {
	<form
		id="form-producto"
		if oob {
			hx-swap-oob="true"
		}
		class="formulario"
		method="post"
		action="/productos"
		enctype="multipart/form-data"
		hx-post="/productos"
		hx-target="#lista-productos"
		hx-swap="outerHTML"
	>
		<h3>Nuevo producto</h3>
		<label>
			Nombre
			<input type="text" name="nombre" value={ f.Nombre } required/>
		</label>
		<label>
			Categoría
			<input type="text" name="categoria" value={ f.Categoria } placeholder="Alfombras, bajo monturas..."/>
		</label>
		<label>
			Color
			<input type="text" name="color" value={ f.Color }/>
		</label>
		<label>
			Precio ($)
			<input type="number" name="precio" value={ f.Precio } step="1" min="1" required/>
		</label>
		<label>
			Descripción
			<textarea name="descripcion" rows="3">{ f.Descripcion }</textarea>
		</label>
		<label>
			Imágenes
			<input type="file" name="imagenes" accept="image/jpeg,image/png,image/webp" multiple/>
		</label>
		if f.Error != "" {
			<p class="mensaje-error" role="alert">{ f.Error }</p>
		}
		<button type="submit">Agregar producto</button>
	</form>
}

// ProductoForm es el formulario normal (página principal y respuesta con error)
templ ProductoForm(f ProductoFormData) {
	@productoForm(f, false)
}

// ProductoFormOOB acompaña a la lista después de un alta y limpia el formulario
templ ProductoFormOOB(f ProductoFormData) {
	@productoForm(f, true)
}
