package views

// Layout es la estructura base de la página. El contenido se recibe como hijo
// y se renderiza dentro de <main> con { children... }.
templ Layout(titulo string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ titulo }</title>
			<link rel="stylesheet" href="/styles.css"/>
		</head>
		<body>
			<header class="encabezado">
				<h1><a href="/">Italpiel S.A.</a></h1>
				<nav>
					<a href="/?ver=cueros">Cueros</a>
					<a href="/?ver=productos">Productos terminados</a>
					<a href="/about.html">Sobre nosotros</a>
				</nav>
			</header>
			<main class="contenedor">
				{ children... }
			</main>
		</body>
	</html>
}
