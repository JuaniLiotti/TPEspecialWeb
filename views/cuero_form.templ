package views

// El id="form-cuero" sirve para dos cosas:
//   - si el servidor rechaza los datos, responde con HX-Retarget: #form-cuero y
//     este formulario vuelve con el error y los valores cargados;
//   - si oob es true, se agrega hx-swap-oob="true" y HTMX lo usa como swap fuera
//     de banda: reemplaza el formulario de la página (así se limpian los campos).
templ cueroForm(f CueroFormData, oob bool) {
	<form
		id="form-cuero"
		if oob {
			hx-swap-oob="true"
		}
		class="formulario"
		method="post"
		action="/cueros"
		enctype="multipart/form-data"
		hx-post="/cueros"
		hx-target="#lista-cueros"
		hx-swap="outerHTML"
	>
		<h3>Nuevo cuero</h3>
		<label>
			Nombre
			<input type="text" name="nombre" value={ f.Nombre } required/>
		</label>
		<label>
			Tipo
			<input type="text" name="tipo" value={ f.Tipo } placeholder="Vacuno, ovino..." required/>
		</label>
		<label>
			Acabado
			<input type="text" name="acabado" value={ f.Acabado } placeholder="Graso, curtido vegetal..."/>
		</label>
		<label>
			Color
			<input type="text" name="color" value={ f.Color }/>
		</label>
		<label>
			Espesor (mm)
			<input type="number" name="espesor_mm" value={ f.EspesorMm } step="0.1" min="0.1" required/>
		</label>
		<label>
			Precio ($)
			<input type="number" name="precio" value={ f.Precio } step="1" min="1" required/>
		</label>
		<label>
			Descripción
			<textarea name="descripcion" rows="3">{ f.Descripcion }</textarea>
		</label>
		<label>
			Imágenes
			<input type="file" name="imagenes" accept="image/jpeg,image/png,image/webp" multiple/>
		</label>
		if f.Error != "" {
			<p class="mensaje-error" role="alert">{ f.Error }</p>
		}
		<button type="submit">Agregar cuero</button>
	</form>
}

// CueroForm es el formulario normal: el de la página principal y el que se
// devuelve con un error de validación.
templ CueroForm(f CueroFormData) {
	@cueroForm(f, false)
}

// CueroFormOOB es el formulario que acompaña a la lista después de un alta:
// HTMX lo intercambia por el #form-cuero de la página (vacío, o con un aviso).
templ CueroFormOOB(f CueroFormData) {
	@cueroForm(f, true)
}
